# Copy to .env.testing for isolated test runs.
APP_NAME=STRUKKU Backend API
APP_ENV=testing
TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost

DATABASE_URL=sqlite:///./strukku-test.db
AUTO_MIGRATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

JWT_SECRET_KEY=testing-secret-1234567890-abcdefghijklmnopqrstuvwxyz-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=

MODEL_PATH=models/model_tfidf_mnb_v1.joblib
CLASSIFIER_PIPELINE=user_history,keyword_rules,ml_model
LOW_CONFIDENCE_THRESHOLD=0.7

OCR_ENGINE=tesseract
TESSERACT_CMD=
OCR_LANG=eng
OCR_PSM=4

STORAGE_BACKEND=local
UPLOAD_DIR=storage/uploads-test
MAX_UPLOAD_MB=8
