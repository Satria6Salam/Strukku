# Copy to the secret/environment manager used by the production server.
# Never commit a real value of this file.
APP_NAME=STRUKKU Backend API
APP_ENV=production
TIMEZONE=Asia/Jakarta
CORS_ORIGINS=https://replace-with-production-domain.example

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTO_MIGRATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

JWT_SECRET_KEY=replace-with-random-token-urlsafe-48-or-longer
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=true
PUBLIC_BASE_URL=https://replace-with-production-domain.example
SMTP_HOST=

MODEL_PATH=models/model_tfidf_mnb_v1.joblib
CLASSIFIER_PIPELINE=user_history,keyword_rules,ml_model
LOW_CONFIDENCE_THRESHOLD=0.7

OCR_ENGINE=tesseract
TESSERACT_CMD=
OCR_LANG=ind+eng
OCR_PSM=4

STORAGE_BACKEND=supabase
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=8
SCAN_ASSET_EXPIRE_HOURS=24
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-private-service-role-key
SUPABASE_STORAGE_BUCKET=receipt-private
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=300
