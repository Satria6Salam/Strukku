# ====== Aplikasi ======
APP_NAME=STRUKKU Backend API
APP_ENV=development
TIMEZONE=Asia/Jakarta
# Asal (origin) yang boleh mengakses API. "*" untuk pengembangan.
CORS_ORIGINS=*

# ====== Database ======
# Lokal (paling mudah, tanpa instalasi apa pun):
DATABASE_URL=sqlite:///./strukku.db
# Supabase PostgreSQL (ganti PROJECT_REF dan PASSWORD):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
AUTO_MIGRATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ====== Keamanan (WAJIB diganti, buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))") ======
JWT_SECRET_KEY=generate-a-random-secret-with-python-secrets-token-url-safe-48
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====== Machine Learning ======
MODEL_PATH=models/model_tfidf_mnb_v1.joblib
CLASSIFIER_PIPELINE=user_history,keyword_rules,ml_model
LOW_CONFIDENCE_THRESHOLD=0.7

# ====== OCR ======
OCR_ENGINE=tesseract
# Windows: C:/Program Files/Tesseract-OCR/tesseract.exe  | Linux/macOS: kosongkan
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANG=ind+eng
OCR_PSM=4

# ====== Penyimpanan gambar ======
STORAGE_BACKEND=local
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=8
SCAN_ASSET_EXPIRE_HOURS=24

# Pilihan produksi Supabase Storage (private bucket):
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key-rahasia>
# SUPABASE_STORAGE_BUCKET=receipt-private
# SUPABASE_SIGNED_URL_EXPIRY_SECONDS=300
